# Everwear API settings. Copy to .env and fill in. Never commit .env.
PORT=9100
# Single-node replica set (needed for transactions) on the local Docker MongoDB.
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGODB_DB=everwear
# Long random string used to sign customer and admin session tokens.
JWT_SECRET=
# Comma-separated browser origins allowed to call the API.
STORE_CORS=http://localhost:8001,http://localhost:8000
ADMIN_CORS=http://localhost:7001
# Public URL of this API (used in image links) and the folder for uploads.
API_PUBLIC_URL=http://localhost:9100
UPLOADS_DIR=uploads

# Payment Providers (Razorpay for India/INR, Stripe for Europe/EUR)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Carrier Logistics (Delhivery and BlueDart)
DELHIVERY_API_KEY=
DELHIVERY_CLIENT_ID=
DELHIVERY_MODE=staging
BLUEDART_CUSTOMER_CODE=
BLUEDART_LOGIN_ID=
BLUEDART_LICENCE_KEY=
BLUEDART_API_MODE=staging
