{
  "name": "@dtc/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Everwear commerce API: catalog, carts, checkout, orders and admin, on Node, Express and MongoDB.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/index.js",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "node --env-file=.env --import tsx --test test/*.test.ts",
    "migrate:medusa": "node --env-file=.env --import tsx scripts/migrate-from-medusa.ts",
    "catalog:localize": "node --env-file=.env --import tsx scripts/localize-catalog.ts",
    "admin:create": "node --env-file=.env --import tsx scripts/create-admin.ts",
    "seed:categories": "node --env-file=.env --import tsx scripts/seed-storefront-categories.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.7.0",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "zod": "^4.6.7"
  }
}
