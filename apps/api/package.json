{
  "name": "@dtc/api",
  "version": "0.1.0",
  "private": true,
  "description": "Everwear commerce API: catalog, carts, checkout, orders and admin, on MongoDB.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/index.js",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "node --env-file=.env --import tsx --test test/*.test.ts",
    "migrate:medusa": "node --env-file=.env --import tsx scripts/migrate-from-medusa.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.14",
    "mongodb": "^7.7.0",
    "zod": "^4.6.7"
  }
}
