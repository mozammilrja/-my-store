# Everwear API settings. Copy to .env and fill in. Never commit .env.
PORT=9100
# Single-node replica set (needed for transactions) on the local Docker MongoDB.
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGODB_DB=everwear
# The single region this store trades in, by currency. Admin reporting scopes
# to it, so revenue is one number rather than a per-currency comparison.
OPERATING_REGION_CURRENCY=inr
# Long random string used to sign customer and admin session tokens.
JWT_SECRET=

# Admin sign-in attempts per email per 15 minutes. Default: 5 in production, 100 otherwise.
# ADMIN_LOGIN_MAX_ATTEMPTS=
# Comma-separated browser origins allowed to call the API.
STORE_CORS=http://localhost:8001,http://localhost:8000
ADMIN_CORS=http://localhost:7001
# Warehouse floor app (picking, packing, dispatch). Its staff sign in at /warehouse/auth/login.
WAREHOUSE_CORS=http://localhost:7101
# Public URL of this API (used in image links) and the folder for uploads.
API_PUBLIC_URL=http://localhost:9100
UPLOADS_DIR=uploads

# ---------------------------------------------------------------------------
# Payments: Razorpay (UPI, cards, net banking, wallets). Online payment is
# offered only when the key pair is set; cash on delivery always works.
# Test keys (rzp_test_...) move no real money. See docs/PAYMENTS_AND_SHIPPING.md.
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Webhooks: URL https://<api>/store/webhooks/razorpay, events
# payment.captured, payment.failed, order.paid, refund.processed, refund.failed.
# The webhook endpoint refuses everything until this is set.
RAZORPAY_WEBHOOK_SECRET=
# Minutes an unpaid payment attempt stays open.
PAYMENT_ATTEMPT_TTL_MINUTES=30

# ---------------------------------------------------------------------------
# Shipping: Shiprocket (Delhivery, Blue Dart, Xpressbees, Ekart, ...).
# "none" records shipments by hand only; no AWB or tracking is ever invented.
# ---------------------------------------------------------------------------
SHIPPING_PROVIDER=shiprocket
# An API user (Settings > API > Create an API User), not your login.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Pickup address nickname exactly as in Settings > Pickup Addresses.
SHIPROCKET_PICKUP_LOCATION=
# Settings > API > Webhooks: URL https://<api>/store/webhooks/courier-tracking
# (Shiprocket rejects URLs containing "shiprocket"); token goes in x-api-key.
SHIPROCKET_WEBHOOK_TOKEN=
# Pincode you ship from, for serviceability and rate checks.
SHIPPING_ORIGIN_PINCODE=
# Parcel defaults when products have no weight (grams) set.
SHIPPING_DEFAULT_WEIGHT_KG=0.5
SHIPPING_DEFAULT_DIMENSIONS_CM=30x25x5
