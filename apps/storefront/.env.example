# ==============================================================================
# EVERWEAR STOREFRONT - ENVIRONMENT CONFIGURATION
# Copy to .env.local for local development or inject in production container.
# ==============================================================================

# Internal API endpoint (Server-side fetch only; never exposed to browser)
# In Docker Compose, this reaches the backend service via container network:
# EVERWEAR_API_URL=http://backend:9100
# In bare-metal or standalone production:
EVERWEAR_API_URL=https://api.everwear.com

# Public API URL used by the browser for image assets and uploads
NEXT_PUBLIC_API_PUBLIC_URL=https://api.everwear.com

# Canonical Base URL of the storefront (used for SEO, metadata, sitemaps, OpenGraph)
NEXT_PUBLIC_BASE_URL=https://everwear.com

# Default region code when accessing root "/" (must be a configured shipping region, e.g. "in" or "dk")
NEXT_PUBLIC_DEFAULT_REGION=in

# Stripe publishable key (used client-side for Stripe Elements / payment intent confirmation)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE_ME

# Optional: Razorpay Key ID for client-side standard checkout modal
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_REPLACE_ME

# Node runtime environment
NODE_ENV=production
