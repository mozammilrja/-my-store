# ==============================================================================
# EVERWEAR COMMERCE PLATFORM - DOCKER & INFRASTRUCTURE ROOT ENVIRONMENT
# Copy to .env in the project root before running docker compose.
# ==============================================================================

# Application Ports (Host mappings)
BACKEND_PORT=9100
STOREFRONT_PORT=8001
ADMIN_PORT=7001
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

# Production Domain Names
DOMAIN_STORE=everwear.com
DOMAIN_ADMIN=admin.everwear.com
DOMAIN_API=api.everwear.com

# Backend & Security Secrets
JWT_SECRET=generate_with_openssl_rand_base64_48_min_32_characters_long
MONGODB_DATABASE=everwear
MONGODB_ROOT_USER=admin
MONGODB_ROOT_PASSWORD=replace_with_secure_mongodb_root_password_123

# CORS Configurations
STORE_CORS=https://everwear.com,https://shop.everwear.com,http://localhost:8001
ADMIN_CORS=https://admin.everwear.com,http://localhost:7001

# Public URLs
API_PUBLIC_URL=https://api.everwear.com
NEXT_PUBLIC_BASE_URL=https://everwear.com
NEXT_PUBLIC_DEFAULT_REGION=in

# Third-Party Payments (Razorpay & Stripe)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Third-Party Logistics (Delhivery & BlueDart)
DELHIVERY_MODE=staging
DELHIVERY_API_KEY=
DELHIVERY_CLIENT_ID=
BLUEDART_API_MODE=staging
BLUEDART_CUSTOMER_CODE=
BLUEDART_LOGIN_ID=
BLUEDART_LICENCE_KEY=
