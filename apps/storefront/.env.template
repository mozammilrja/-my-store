# Everwear storefront settings. Copy to .env.local.
# Address of the Everwear API (apps/backend). Server-side only.
EVERWEAR_API_URL=http://localhost:9100
# Public address the browser uses for API-hosted images, if different (production).
NEXT_PUBLIC_API_PUBLIC_URL=
# Country shown at "/" (must be a country the store ships to).
NEXT_PUBLIC_DEFAULT_REGION=dk
# Public URL of this storefront, used in canonical links and the sitemap.
NEXT_PUBLIC_BASE_URL=http://localhost:8001
