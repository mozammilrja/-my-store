# Everwear storefront settings. Copy to .env.local.
# Address of the Everwear API (apps/backend). Server-side only.
EVERWEAR_API_URL=http://localhost:9100
# Public address the browser uses for API-hosted images, if different (production).
NEXT_PUBLIC_API_PUBLIC_URL=
# The store's only country (India). Shown at "/"; other country codes redirect here.
NEXT_PUBLIC_DEFAULT_REGION=in
# Public URL of this storefront, used in canonical links and the sitemap.
NEXT_PUBLIC_BASE_URL=http://localhost:8001
# Seller of record printed on tax invoices. Fallback only: the store settings in the
# database (PATCH /admin/settings { seller }) take precedence. Leave empty when unknown;
# empty fields are left off the invoice rather than invented.
SELLER_LEGAL_NAME=
SELLER_GSTIN=
SELLER_CIN=
SELLER_ADDRESS=
# State with GST state code, e.g. "Delhi (07)"
SELLER_STATE=
SELLER_EMAIL=
SELLER_PHONE=
