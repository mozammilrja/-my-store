# ==============================================================================
# EVERWEAR ADMIN DASHBOARD - ENVIRONMENT CONFIGURATION
# Vite client-side environment variables (must be prefixed with VITE_)
# ==============================================================================

# Public URL of the Everwear Backend API
# In production, this points to your public API gateway domain:
VITE_API_URL=https://api.everwear.com

# For local development with backend running on port 9100:
# VITE_API_URL=http://localhost:9100
