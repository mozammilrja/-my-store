# ==============================================================================
# EVERWEAR COMMERCE BACKEND - ENVIRONMENT CONFIGURATION
# Copy to .env for local runtime or inject via Docker / Kubernetes in production.
# ==============================================================================

# Server Environment & Port
NODE_ENV=production
PORT=9100

# Public API URL (used for constructing absolute URLs for uploaded product media and webhooks)
API_PUBLIC_URL=https://api.everwear.com

# Uploads directory on the host filesystem (served statically at /uploads)
UPLOADS_DIR=uploads

# MongoDB Connection String (must include replicaSet for multi-document ACID transactions)
# Production example: mongodb://mongodb:27017/everwear?replicaSet=rs0
# Local standalone replica set example: mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGODB_URI=mongodb://mongodb:27017/everwear?replicaSet=rs0
MONGODB_DB=everwear

# Security: JWT Secret (must be minimum 32 characters long random string)
# Generate with: openssl rand -base64 48
JWT_SECRET=replace_with_a_secure_random_string_of_at_least_32_characters

# CORS Allowed Origins (comma-separated browser origins)
# STORE_CORS: Origins allowed to access /store/* routes
STORE_CORS=https://everwear.com,https://shop.everwear.com
# ADMIN_CORS: Origins allowed to access /admin/* routes
ADMIN_CORS=https://admin.everwear.com

# ==============================================================================
# PAYMENT PROVIDERS
# ==============================================================================

# Razorpay (Primary gateway for INR / India transactions)
# Obtain from Razorpay Dashboard -> Settings -> API Keys & Webhooks
RAZORPAY_KEY_ID=rzp_live_REPLACE_ME
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Stripe (Primary gateway for EUR / Europe transactions)
# Obtain from Stripe Dashboard -> Developers -> API Keys & Webhooks
STRIPE_SECRET_KEY=sk_live_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE_ME

# ==============================================================================
# CARRIER LOGISTICS & DISPATCH
# ==============================================================================

# Delhivery Express (Primary carrier for India domestic express & return pickups)
# Mode: "staging" for sandbox API, "production" for live manifests
DELHIVERY_MODE=production
DELHIVERY_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DELHIVERY_CLIENT_ID=EVERWEAR_PROD

# BlueDart Express (Alternative air carrier for high-priority shipments)
# Mode: "staging" for sandbox API, "production" for live manifests
BLUEDART_API_MODE=production
BLUEDART_CUSTOMER_CODE=xxxxxx
BLUEDART_LOGIN_ID=xxxxxx
BLUEDART_LICENCE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
